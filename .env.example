# Core app
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-secure-random-secret

# Database
# Use ?pgbouncer=true if connecting via Supabase connection pooler (port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_lms

# Email
RESEND_API_KEY=re_replace
EMAIL_FROM=noreply@example.com

# AI
OPENAI_API_KEY=sk_replace

# Upload / asset storage
UPLOADTHING_SECRET=replace
UPLOADTHING_APP_ID=replace

# Billing (future provider integration)
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace

# Optional observability
SENTRY_DSN=
